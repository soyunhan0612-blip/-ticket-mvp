{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/hooks/codex-block-dangerous.cjs\"",
            "commandWindows": "powershell -NoProfile -NonInteractive -Command \"& { $root = git rev-parse --show-toplevel; & node \\\"$root/scripts/hooks/codex-block-dangerous.cjs\\\" }\"",
            "timeout": 10,
            "statusMessage": "위험 명령 검사"
          }
        ]
      },
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/hooks/codex-tdd-guard.cjs\"",
            "commandWindows": "powershell -NoProfile -NonInteractive -Command \"& { $root = git rev-parse --show-toplevel; & node \\\"$root/scripts/hooks/codex-tdd-guard.cjs\\\" }\"",
            "timeout": 15,
            "statusMessage": "TDD 가드 검사"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/zsh -lc 'node \"$(git rev-parse --show-toplevel)/scripts/hooks/codex-verify-gate.cjs\"'",
            "commandWindows": "powershell -NoProfile -NonInteractive -Command \"& { $root = git rev-parse --show-toplevel; & node \\\"$root/scripts/hooks/codex-verify-gate.cjs\\\" }\"",
            "timeout": 360,
            "statusMessage": "lint·test 게이트"
          }
        ]
      }
    ]
  }
}
