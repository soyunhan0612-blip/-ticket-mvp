# Haiku 4.5 셀러 등록 AI 설명 생성용 (Day 8)
ANTHROPIC_API_KEY=

# Redis 영속화 URL (Day 9)
UPSTASH_REDIS_REST_URL=

# Redis 영속화 인증 토큰 (Day 9)
UPSTASH_REDIS_REST_TOKEN=

# /admin·/seller 미들웨어 Basic Auth 사용자명·비밀번호 (Day 8)
# 두 값 중 하나라도 비어 있으면 /admin·/seller는 401로 닫힌다.
# 빈 값은 인증 통과가 아니라 거부로 처리된다 (src/lib/basic-auth.ts).
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
