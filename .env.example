# Anthropic API (optional; the app uses a mock response when unset)
ANTHROPIC_API_KEY=

# Upstash Redis (required only when STORE_BACKEND=redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Basic Auth for /admin and /seller
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# Persistence backend: memory for local development, redis for deployment
STORE_BACKEND=memory
